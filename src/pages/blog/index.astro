---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogPosts = await getCollection("blog");
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
var theme = "box-shadow: inset 0 0 300rem 100px var(--pm-morado);";
---

<BaseLayout
  title="Blog"
  description="Blog sobre turismo, naturaleza y cultura de Huauchinango"
  color="border-bottom: 2px solid var(--pm-morado);"
>
  <div class="hero" style={theme}>
    <img src="/image/bloghero.jpg" alt="">
    <h1 transition:name="hero" transition:animate="slide">Blog</h1>
    <p>Historias, consejos, noticias y descubrimientos sobre Huauchinango</p>
  </div>

  <div class="blog-list">
    {
      sortedPosts.map((post) => (
        <article class="blog-post">
          <img src={post.data.image} alt={post.data.title} loading="lazy" />
          <h2>{post.data.title}</h2>
          <p class="date">
            {post.data.date.toLocaleDateString("es-MX", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}{" "}
            - {post.data.author}
          </p>
          <p>{post.data.description}</p>
          <a href={`/blog/${post.slug}`}>Leer más →</a>
        </article>
      ))
    }
  </div>
</BaseLayout>
